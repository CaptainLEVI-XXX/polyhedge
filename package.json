{
  "name": "polyhedge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "demo": "node --import tsx examples/simulated-lifecycle.ts",
    "benchmark:hedge": "node --import tsx examples/hedge-benchmark.ts",
    "db:migrate": "node --import tsx examples/migrate.ts",
    "web": "pnpm --filter @polyhedge/web dev",
    "verify:solver": "node apps/web/scripts/verify-solver.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.1",
    "fast-check": "^4.10.1",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@electric-sql/pglite": "0.5.8",
    "viem": "^2.37.0",
    "@polymarket/client": "0.10.0"
  }
}
